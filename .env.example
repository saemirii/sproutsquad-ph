# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://sproutsquad-ph.netlify.app/"

# Supabase project settings. Find these in Project Settings > API.
VITE_SUPABASE_URL="https://endqxhcjnmvpwiteghna.supabase.co"
VITE_SUPABASE_ANON_KEY="REPLACE_WITH_YOUR_SUPABASE_ANON_KEY"

# The deployed backend the native iOS app calls for its own /api/* routes
# (e.g. deleteAccount). capacitor://localhost isn't a real server, so
# native builds need an absolute URL here — the web build ignores this since
# it's served *by* this same origin, so its relative /api/* paths already
# resolve correctly on their own.
VITE_APP_URL="https://sproutsquad-ph.netlify.app"

# RevenueCat Web Billing public API key (client-side, safe to expose in the
# bundle — it's a *public* key). Get it from the RevenueCat dashboard under
# your Web Billing app > API Keys. Sprout+ subscriptions won't load without it.
VITE_REVENUECAT_PUBLIC_KEY="REPLACE_WITH_YOUR_REVENUECAT_WEB_BILLING_PUBLIC_KEY"

# RevenueCat iOS app public API key — a *separate* key from the Web Billing
# one above, issued under a distinct "app" entry in the same RevenueCat
# project/dashboard (Apps > your iOS app > API Keys). Only used by the
# native Capacitor build (src/lib/revenuecat.native.ts); the web build never
# loads this module, so this can be left blank for Netlify.
VITE_REVENUECAT_IOS_PUBLIC_KEY="REPLACE_WITH_YOUR_REVENUECAT_IOS_PUBLIC_KEY"

# --- Server-side only below. Never prefix these with VITE_ — that would bundle
# --- them into client-side code and expose them publicly.

# Supabase service-role key. Required only by the RevenueCat webhook handler
# (server.ts) so it can write subscription records bypassing RLS. Find it in
# Supabase Project Settings > API > service_role secret. NEVER expose this to
# the browser.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY"

# The Authorization header value RevenueCat will send with every webhook
# request. Set the same value in the RevenueCat dashboard under Project
# Settings > Webhooks > Authorization header. Used to verify incoming
# webhook requests actually came from RevenueCat.
REVENUECAT_WEBHOOK_AUTHORIZATION="REPLACE_WITH_A_LONG_RANDOM_SECRET_YOU_ALSO_SET_IN_REVENUECAT_DASHBOARD"

# RevenueCat V2 Secret API key (NOT the public SDK key above, and NOT a V1
# secret key — this app's promo-code grant calls the V2 REST API, which only
# accepts V2-generation keys). Create one in the RevenueCat dashboard under
# Project Settings > API Keys > "V2" > Create new, with the
# customer_information:customers:read_write permission. NEVER expose this to
# the browser. See server/promoCode.ts.
REVENUECAT_SECRET_API_KEY="REPLACE_WITH_YOUR_REVENUECAT_V2_SECRET_API_KEY"

# RevenueCat project ID — the V2 API is scoped by project (V1 wasn't). Find
# it in the RevenueCat dashboard under Project Settings; it's in that page's
# URL too (app.revenuecat.com/projects/<this-value>/...).
REVENUECAT_PROJECT_ID="REPLACE_WITH_YOUR_REVENUECAT_PROJECT_ID"

# The shared code reviewers/judges enter in the app's Subscription page to
# unlock Sprout+ for free (one month, no purchase) — see server/promoCode.ts.
# Pick any value; it's compared server-side only, never shipped to clients.
JUDGE_PROMO_CODE="REPLACE_WITH_A_CODE_YOU_SHARE_WITH_REVIEWERS"
